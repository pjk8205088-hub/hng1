ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=use-a-long-random-password
# Mount a Railway volume and point this at it for durable admin data.
ADMIN_DATA_FILE=/data/admin-data.json

EBANX_ENABLED=false
EBANX_INTEGRATION_KEY=replace-with-ebanx-integration-key
EBANX_API_BASE=https://sandbox.ebanxpay.com
EBANX_NOTIFICATION_URL=https://hng1.com/api/webhooks/ebanx

DLOCALGO_ENABLED=false
DLOCALGO_API_KEY=replace-with-dlocal-go-api-key
DLOCALGO_API_SECRET=replace-with-dlocal-go-api-secret
DLOCALGO_API_BASE=https://api-sbx.dlocalgo.com
DLOCALGO_NOTIFICATION_URL=https://hng1.com/api/webhooks/dlocalgo
DLOCALGO_SUCCESS_URL=https://hng1.com/?payment=success
DLOCALGO_BACK_URL=https://hng1.com/?payment=return
